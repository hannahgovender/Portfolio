<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Jetour — Drag Reveal</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Archivo:wght@600;800&display=swap');

  :root {
    --bg-0: #16171b;
    --bg-1: #1f2126;
    --panel: #24262b;
    --line: rgba(255,255,255,0.08);
    --ink: #f2f1ee;
    --ink-dim: #9a9ca2;
    --accent: #b9a6ff;
    --accent-dim: #7c6fb0;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    height: 100%;
    background: var(--bg-0);
    font-family: 'Space Grotesk', sans-serif;
    color: var(--ink);
    overflow: hidden;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 560px;
    background:
      radial-gradient(1200px 600px at 15% -10%, rgba(185,166,255,0.10), transparent 60%),
      repeating-linear-gradient(115deg, rgba(255,255,255,0.035) 0px, rgba(255,255,255,0.035) 2px, transparent 2px, transparent 34px),
      linear-gradient(160deg, var(--bg-1) 0%, var(--bg-0) 55%, #101114 100%);
    cursor: crosshair;
    user-select: none;
    touch-action: none;
  }

  .stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(0,0,0,0.45) 100%);
    pointer-events: none;
  }

  .hud {
    position: absolute;
    top: 0; left: 0; right: 0;
    padding: 42px 48px 0;
    pointer-events: none;
    z-index: 5;
  }

  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 10px;
  }

  h1 {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 7vw, 74px);
    line-height: 0.95;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .sub {
    margin: 16px 0 0;
    max-width: 380px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .hint {
    position: absolute;
    bottom: 34px;
    left: 48px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--ink-dim);
    z-index: 5;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .hint.hide { opacity: 0; }

  .hint .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(185,166,255,0.55);
    animation: pulse 1.8s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(185,166,255,0.5); }
    70%  { box-shadow: 0 0 0 9px rgba(185,166,255,0); }
    100% { box-shadow: 0 0 0 0 rgba(185,166,255,0); }
  }

  .counter {
    position: absolute;
    bottom: 34px;
    right: 48px;
    font-size: 12.5px;
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    z-index: 5;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  .counter b { color: var(--accent); font-weight: 600; }

  .card {
    position: absolute;
    width: 168px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow:
      0 10px 30px rgba(0,0,0,0.45),
      0 2px 8px rgba(0,0,0,0.35);
    pointer-events: none;
    will-change: transform, opacity;
    animation: reveal 1.9s cubic-bezier(.2,.8,.2,1) forwards;
    z-index: 3;
  }

  .card img {
    display: block;
    width: 100%;
    height: 112px;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.03);
  }

  .card .tag {
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--ink-dim);
    padding: 7px 9px 8px;
    border-top: 1px solid var(--line);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes reveal {
    0% {
      opacity: 0;
      transform: translate(-50%,-50%) scale(0.72) rotate(var(--rot));
    }
    12% {
      opacity: 1;
      transform: translate(-50%,-50%) scale(1) rotate(var(--rot));
    }
    70% {
      opacity: 1;
      transform: translate(-50%,-50%) scale(1) rotate(var(--rot));
    }
    100% {
      opacity: 0;
      transform: translate(-50%,-50%) scale(0.94) rotate(var(--rot));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card { animation-duration: 0.4s; }
  }

  @media (max-width: 640px) {
    .hud { padding: 26px 22px 0; }
    .sub { display: none; }
    .hint { left: 22px; bottom: 22px; }
    .counter { right: 22px; bottom: 22px; }
    .card { width: 122px; }
    .card img { height: 82px; }
  }
</style>
</head>
<body>

<div class="stage" id="stage">
  <div class="hud">
    <p class="eyebrow">Portfolio · Interaction study</p>
    <h1>Jetour</h1>
    <p class="sub">Click and drag anywhere across this panel — the shoot reveals itself along your cursor's path.</p>
  </div>

  <div class="hint" id="hint"><span class="dot"></span> Click + drag to reveal</div>
  <div class="counter" id="counter">0 <b>frames</b> revealed</div>
</div>

<script>
const IMAGES = [
  { src: "data:image/jpeg;base64,", label: "Side profile" },
  { src: "data:image/jpeg;base64,", label: "Headlight detail" },
  { src: "data:image/jpeg;base64,", label: "Rear / door detail" },
  { src: "data:image/jpeg;base64,", label: "Rear three-quarter" },
  { src: "data:image/jpeg;base64,", label: "Cockpit" },
  { src: "data:image/jpeg;base64,", label: "Front detail" }
];

const stage = document.getElementById('stage');
const hint = document.getElementById('hint');
const counterEl = document.getElementById('counter');

let dragging = false;
let lastSpawn = 0;
let idx = 0;
let count = 0;
const MIN_GAP_MS = 110;
const MIN_DIST = 46;
let lastPt = null;

function pointFromEvent(e) {
  const rect = stage.getBoundingClientRect();
  const p = e.touches ? e.touches[0] : e;
  return { x: p.clientX - rect.left, y: p.clientY - rect.top };
}

function spawnCard(x, y) {
  const item = IMAGES[idx % IMAGES.length];
  idx++;
  count++;
  counterEl.innerHTML = count + ' <b>frames</b> revealed';

  const card = document.createElement('div');
  card.className = 'card';
  const rot = (Math.random() * 12 - 6).toFixed(2) + 'deg';
  card.style.setProperty('--rot', rot);
  card.style.left = x + 'px';
  card.style.top = y + 'px';

  const img = document.createElement('img');
  img.src = item.src;
  img.draggable = false;
  const tag = document.createElement('div');
  tag.className = 'tag';
  tag.textContent = item.label;

  card.appendChild(img);
  card.appendChild(tag);
  stage.appendChild(card);

  card.addEventListener('animationend', () => card.remove());
}

function maybeSpawn(e) {
  if (!dragging) return;
  const now = performance.now();
  const pt = pointFromEvent(e);
  if (lastPt) {
    const d = Math.hypot(pt.x - lastPt.x, pt.y - lastPt.y);
    if (now - lastSpawn < MIN_GAP_MS && d < MIN_DIST) return;
  }
  lastSpawn = now;
  lastPt = pt;
  spawnCard(pt.x, pt.y);
}

function startDrag(e) {
  dragging = true;
  hint.classList.add('hide');
  lastPt = null;
  maybeSpawn(e);
}
function endDrag() {
  dragging = false;
  lastPt = null;
}

stage.addEventListener('mousedown', startDrag);
window.addEventListener('mousemove', maybeSpawn);
window.addEventListener('mouseup', endDrag);

stage.addEventListener('touchstart', (e) => { startDrag(e); }, { passive: true });
stage.addEventListener('touchmove', (e) => { maybeSpawn(e); }, { passive: true });
window.addEventListener('touchend', endDrag);
</script>

</body>
</html>
